{
  "name": "pi-openui",
  "version": "0.1.2",
  "type": "module",
  "description": "Pi extension: interactive dashboards, charts, diagrams and maps in the terminal. The agent draws with OpenUI Lang; you click, hover and pin notes.",
  "license": "MIT",
  "author": "David Dai",
  "homepage": "https://github.com/newtonapple/pi-openui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newtonapple/pi-openui.git"
  },
  "bugs": {
    "url": "https://github.com/newtonapple/pi-openui/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "openui",
    "tui",
    "terminal",
    "dashboard",
    "charts",
    "diagrams",
    "widgets",
    "visualization"
  ],
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ],
    "image": "https://raw.githubusercontent.com/newtonapple/pi-openui/main/docs/screenshots/dashboard.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --import ./test/register-pi.mjs --test --test-reporter=spec test/*.test.ts",
    "gallery": "node scripts/langgallery.ts",
    "width": "node --import ./test/register-pi.mjs scripts/width-table.ts",
    "screenshots": "node --import ./test/register-pi.mjs scripts/shots.ts && python3 scripts/render_shots.py && python3 scripts/hero.py",
    "docs": "node scripts/gen_docs.ts",
    "prepublishOnly": "npm test"
  }
}
